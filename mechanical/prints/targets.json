  "paths":
  {
    "output_dir": "mechanical/exports/print/gcodes",
    "plate_3mf_template": "mechanical/exports/print/plates/{plate}.generic.3mf",
    "combined_stl_template": "mechanical/exports/print/plates/positioned_stls/{plate}.combined.stl"
  },

  "plates":
  [
    "frame",
    "color-coding",
    "clearance-gauge"
  ],

  "slicers":
  {
    "prusaslicer":
    {
      "input_type": "3mf",

      "printers":
      {
        "coreone":
        {
          "printer_profile": "Prusa CORE One HF0.4 nozzle",
          "print_profile": "-=COMET=- 0.20mm STRUCTURAL @COREONE HF0.4",
          "center": [125, 115],

          "materials":
          {
            "prusament_pccf":
            {
              "material_profile": "-=COMET=- Prusament PC Blend Carbon Fiber @COREONE HF0.4",

              "plates":
              [
                "clearance-gauge",
                "frame"
              ]
            },

            "prusament_petg":
            {
              "material_profile": "Prusament PETG @COREONE HF0.4",

              "plates":
              [
                "clearance-gauge",
                "color-coding"
              ]
            }
          }
        }
      }
    }
  }
}